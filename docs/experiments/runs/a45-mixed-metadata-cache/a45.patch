Subject: [PATCH] experiment(iluvatar): cache mixed-batch decode indices

---
 .../attention/test_vendor_flash_attn.py       | 41 +++++++++++++++++++
 .../vendor/iluvatar/impl/vendor_flash_attn.py | 16 ++++----
 2 files changed, 50 insertions(+), 7 deletions(-)
 create mode 100644 tests/unit_tests/attention/test_vendor_flash_attn.py

diff --git a/tests/unit_tests/attention/test_vendor_flash_attn.py b/tests/unit_tests/attention/test_vendor_flash_attn.py
new file mode 100644
index 0000000..ce9d25f
--- /dev/null
+++ b/tests/unit_tests/attention/test_vendor_flash_attn.py
@@ -0,0 +1,41 @@
+import dataclasses
+
+import torch
+
+from vllm_fl.dispatch.backends.vendor.iluvatar.impl.vendor_flash_attn import (
+    _build_split,
+    _decode_index,
+)
+
+
+def test_decode_index_reuses_same_tensor():
+    _decode_index.cache_clear()
+    first = _decode_index((0, 2, 4), torch.device("cuda"))
+    second = _decode_index((0, 2, 4), torch.device("cuda"))
+    assert first is second
+    assert first.tolist() == [0, 2, 4]
+
+
+def test_build_split_uses_gpu_metadata():
+    @dataclasses.dataclass
+    class Meta:
+        query_start_loc: torch.Tensor
+        seq_lens: torch.Tensor
+        block_table: torch.Tensor
+        num_actual_tokens: int = 6
+        max_query_len: int = 3
+
+    m = Meta(
+        query_start_loc=torch.tensor([0, 1, 3, 6], device="cuda", dtype=torch.int64),
+        seq_lens=torch.tensor([4, 5, 6], device="cuda", dtype=torch.int32),
+        block_table=torch.tensor([[1, 2], [3, 4], [5, 6]], device="cuda"),
+    )
+    _build_split(m, [0, 1, 3, 6], [4, 5, 6])
+    cu_l, seq_l, pre_idx, dec_rows, dec_meta = m._fl_split
+    assert pre_idx == [1, 2]
+    assert dec_rows.tolist() == [0]
+    assert dec_meta.seq_lens.tolist() == [4]
+    assert dec_meta.block_table.tolist() == [[1, 2]]
+    assert dec_meta.num_actual_tokens == 1
+    assert dec_meta.max_query_len == 1
+    assert dec_meta.query_start_loc.tolist() == [0, 1]
diff --git a/vllm_fl/dispatch/backends/vendor/iluvatar/impl/vendor_flash_attn.py b/vllm_fl/dispatch/backends/vendor/iluvatar/impl/vendor_flash_attn.py
index 0a7b7c5..063fb8a 100644
--- a/vllm_fl/dispatch/backends/vendor/iluvatar/impl/vendor_flash_attn.py
+++ b/vllm_fl/dispatch/backends/vendor/iluvatar/impl/vendor_flash_attn.py
@@ -27,6 +27,7 @@ VLLM_FL_DISABLE_ILUVATAR_VENDOR_FA=1: A/B switch back to stock.
 """
 
 import dataclasses
+import functools
 import os
 import time as _time
 
@@ -109,6 +110,11 @@ def _pool(name, rows, hkv, d, dtype, dev):
     return buf
 
 
+@functools.lru_cache(maxsize=8)
+def _decode_index(dec_idx, dev):
+    return torch.tensor(dec_idx, dtype=torch.int64, device=dev)
+
+
 def _build_split(m, cu_l, seq_l):
     """Compute the decode/prefill request split from CPU lists, attach GPU
     tensors for the decode subset.  Runs once per step in the builder.
@@ -124,13 +130,9 @@ def _build_split(m, cu_l, seq_l):
     dev = m.query_start_loc.device
     if dec_idx:
         n = len(dec_idx)
-        idx_t = torch.tensor(dec_idx, dtype=torch.int64).to(dev, non_blocking=True)
-        dec_rows = torch.tensor(
-            [cu_l[i] for i in dec_idx], dtype=torch.int64).to(
-                dev, non_blocking=True)
-        seq_dec = torch.tensor(
-            [seq_l[i] for i in dec_idx], dtype=m.seq_lens.dtype).to(
-                dev, non_blocking=True)
+        idx_t = _decode_index(tuple(dec_idx), dev)
+        dec_rows = torch.index_select(m.query_start_loc, 0, idx_t)
+        seq_dec = torch.index_select(m.seq_lens, 0, idx_t)
         dec_meta = dataclasses.replace(
             m,
             num_actual_tokens=n,
