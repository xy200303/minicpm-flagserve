+        key=["x"],
+    )
+    @triton.jit
+    def main_kernel(x, y):
+        return sub_func(x, y) * 2
+
+    original_hash = main_kernel.kernel_hash
+
+    @triton.jit
+    def sub_func(x, y):  # noqa:F811
+        return x + y + 1
+
+    @libtuner(
+        configs=[
+            triton.Config({"TILE_N": 32}),
+            triton.Config({"TILE_N": 64}),
