+def softmax_inner_decorator_cascade(x, dim, dtype=None):
+    assert dim >= -x.ndim and dim < x.ndim, "Invalid dim"
+    dim = dim % x.ndim
+    M = 1
+    N = x.shape[dim]
+    for i in range(dim):
+        M *= x.shape[i]  # pre_dim
+    inp = x.contiguous()
+    if dtype is None:
+        dtype = x.dtype
+
+    out = torch.empty_like(inp, dtype=dtype)
+
+    with torch_device_fn.device(out.device):
+        grid = lambda meta: (triton.cdiv(M, meta["TILE_M"]), 1, 1)
+        softmax_kernel_inner[grid](
+            out,
+            inp,
+            M,
+            N,
+            DUMMY=60,
+        )
+    return out
+
+
+def softmax_inner_pass_kernel_arg_via_kw(x, dim, dtype=None):
+    assert dim >= -x.ndim and dim < x.ndim, "Invalid dim"
+    dim = dim % x.ndim
+    M = 1
+    N = x.shape[dim]
+    for i in range(dim):
+        M *= x.shape[i]  # pre_dim
+    inp = x.contiguous()
+    if dtype is None:
+        dtype = x.dtype
+    out = torch.empty_like(inp, dtype=dtype)
+
+    grid = lambda meta: (triton.cdiv(M, meta["TILE_M"]), 1, 1)
+    softmax_kernel_inner[grid](
+        out,
+        inp,
+        M,
+        N=N,
+        DUMMY=60,
+    )
+    return out
+
+
+def softmax_inner_kernel_arg_apply_default(x, dim, dtype=None):
+    assert dim >= -x.ndim and dim < x.ndim, "Invalid dim"
+    dim = dim % x.ndim
+    M = 1
+    N = x.shape[dim]
+    for i in range(dim):
+        M *= x.shape[i]  # pre_dim
+    inp = x.contiguous()
+    if dtype is None:
+        dtype = x.dtype
+    out = torch.empty_like(inp, dtype=dtype)
+
+    grid = lambda meta: (triton.cdiv(M, meta["TILE_M"]), 1, 1)
+    softmax_kernel_inner[grid](
+        out,
+        inp,
+        M,
