+
+def mm_silu_mul(a, b):
+    if a.stride(0) > 1 and a.stride(1) > 1:
+        a = a.contiguous()
+    if b.stride(0) > 1 and b.stride(1) > 1:
+        b = b.contiguous()
+    assert a.shape[1] == b.shape[0], "incompatible dimensions"
+    M, K = a.shape
+    _, N = b.shape
+    assert N % 2 == 0, "mm_silu_mul requires an even output width"
+    cfg = _pinned_cfg(M, K, N)
