From 59a73960f0e2df925b0a98ad45905809a793bbb3 Mon Sep 17 00:00:00 2001
From: xy200303 <3483421977@qq.com>
Date: Tue, 3 Nov 2026 18:19:53 +0800
Subject: [PATCH 2/3] experiment(copy): add contiguous same-dtype fast path

---
 src/flag_gems/ops/copy.py | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/flag_gems/ops/copy.py b/src/flag_gems/ops/copy.py
index 5d565821..e4430254 100644
--- a/src/flag_gems/ops/copy.py
+++ b/src/flag_gems/ops/copy.py
@@ -17,8 +17,9 @@ from typing import Optional
 
 import torch
 import triton
+import triton.language as tl
 
-from flag_gems.utils import pointwise_dynamic
+from flag_gems.utils import libentry, pointwise_dynamic
 
 logger = logging.getLogger(__name__)
 
@@ -35,6 +36,14 @@ def _copy_kernel(src):
     return src
 
 
+@libentry()
+@triton.jit
+def _copy_contiguous_kernel(dst, src, n, BLOCK: tl.constexpr):
+    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offsets < n
+    tl.store(dst + offsets, tl.load(src + offsets, mask=mask), mask=mask)
+
+
 def _can_use_triton(dst: torch.Tensor, src: torch.Tensor) -> bool:
     if dst.layout != torch.strided or src.layout != torch.strided:
         return False
@@ -125,6 +134,16 @@ def copy_(dst: torch.Tensor, src: torch.Tensor, non_blocking: bool = False):
 
     logger.debug("GEMS COPY_")
 
+    if (
+        dst.dtype == src.dtype
+        and dst.shape == src.shape
+        and dst.is_contiguous()
+        and src.is_contiguous()
+    ):
+        n = dst.numel()
+        _copy_contiguous_kernel[(triton.cdiv(n, 1024),)](dst, src, n, BLOCK=1024)
+        return dst
+
     try:
         broadcast_shape = torch.broadcast_shapes(dst.shape, src.shape)
     except RuntimeError as exc:
-- 
