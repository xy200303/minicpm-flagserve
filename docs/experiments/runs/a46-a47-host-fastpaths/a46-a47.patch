@@ -1702,7 +1703,8 @@ class LibEntry(triton.KernelInterface):
             cache = self._cpu_cache
         else:
             cache = self.kernel_cache[device]
-        while entry_key not in cache:
+        cached = cache.get(entry_key)
+        while cached is None:
