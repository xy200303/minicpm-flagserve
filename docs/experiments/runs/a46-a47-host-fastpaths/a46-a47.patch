+            meta = dict(zip(self.arg_names, args))
+            meta.update(kwargs)
+            meta.update(constexprs)
             grid = grid(meta)
         grid = grid + (1, 1)
 
         if launch_pre_hooks:
-            hook_nargs = {**dict(zip(self.arg_names, args)), **kwargs}
+            hook_nargs = dict(zip(self.arg_names, args))
+            hook_nargs.update(kwargs)
             for pre_hook, hook_kwargs in launch_pre_hooks:
                 pre_hook({**hook_nargs, **hook_kwargs})
 
         if major_version == 3 and 3 <= minor_version <= 6:
             all_args = []
             missing_keys = []
-            for key in list(self.signature.parameters.keys()):
+            for key in self.param_names:
                 if key in k_args:
                     all_args.append(k_args[key])
                 elif key in tune_constexprs:
diff --git a/tests/test_libentry.py b/tests/test_libentry.py
index 246e249f..12e408ce 100644
--- a/tests/test_libentry.py
+++ b/tests/test_libentry.py
@@ -1894,3 +1894,25 @@ def test_sql_model_loads_requested_table(tmp_path):
     with sqlalchemy.orm.Session(engine) as session:
         assert session.get(model, {"key_0": 64}).num_warps == 4
     assert SQLPersistantModel.build_sql_model_by_db("missing", engine) is None
+
+
+def test_libentry_key_preserves_tensor_and_integer_specialization():
+    tensor = torch.empty(16, dtype=torch.float32)
+    entry = softmax_kernel_inner
+    key = entry.key(
+        [tensor, 0, 2**31],
+        [tensor, -(2**31) - 1, 2**63, 2**64],
+        [32, True],
+    )
+    assert key == (
+        (tensor.dtype, tensor.data_ptr() % entry.divisibility == 0),
+        (int, 0),
+        (int, 2**31),
+        tensor.dtype,
+        "i64",
+        "u64",
+        "i64",
+        32,
+        True,
+    )
+    assert entry.param_names == tuple(entry.signature.parameters)
