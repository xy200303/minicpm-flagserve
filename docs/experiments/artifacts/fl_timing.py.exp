"""Temporary phase-timing instrumentation for the Iluvatar spec-decode step.

Enabled with VLLM_FL_TIMING=1. Prints, every 25 steps, the wall time of the
main runner phases plus the shape of the scheduled batch (min/max tokens per
request), which distinguishes host overhead from GPU work and shows whether
the batch is uniform (1 + k tokens for every request).
"""
import logging
import os
import time

logger = logging.getLogger(__name__)

_INSTALLED = False


def install():
    global _INSTALLED
    if _INSTALLED or os.getenv("VLLM_FL_TIMING", "0") != "1":
        return
    from vllm.v1.worker.gpu_model_runner import GPUModelRunner

    acc = {"steps": 0, "gap": 0.0, "step": 0.0, "update_states": 0.0,
           "forward": 0.0, "sample": 0.0, "prop": 0.0, "minq": 0, "maxq": 0,
           "tot": 0, "nreq": 0}
    last = {"t": None}

    def wrap(name, key):
        orig = getattr(GPUModelRunner, name)

        def inner(self, *a, **kw):
            t0 = time.perf_counter()
            r = orig(self, *a, **kw)
            acc[key] += (time.perf_counter() - t0) * 1000.0
            return r

        setattr(GPUModelRunner, name, inner)

    def wrap_step(name):
        orig = getattr(GPUModelRunner, name)

        def inner(self, *a, **kw):
            t0 = time.perf_counter()
            if last["t"] is not None:
                acc["gap"] += (t0 - last["t"]) * 1000.0
            r = orig(self, *a, **kw)
            acc["step"] += (time.perf_counter() - t0) * 1000.0
            last["t"] = time.perf_counter()
            so = a[0] if a else kw.get("scheduler_output")
            try:
                vals = list(so.num_scheduled_tokens.values())
                if vals:
                    acc["minq"] += min(vals)
                    acc["maxq"] += max(vals)
                    acc["tot"] += sum(vals)
                    acc["nreq"] += len(vals)
            except Exception:
                pass
            acc["steps"] += 1
            if acc["steps"] % 25 == 0:
                n = acc["steps"]
                nr = max(acc["nreq"], 1)
                logger.warning(
                    "fl timing (%d steps): step=%.0f ms/step (gap %.0f) | "
                    "update_states=%.1f forward=%.1f sample=%.1f propose=%.1f | "
                    "batch: reqs=%.1f tok/step=%.1f q_min=%.1f q_max=%.1f",
                    n, acc["step"] / n, acc["gap"] / n, acc["update_states"] / n,
                    acc["forward"] / n, acc["sample"] / n, acc["prop"] / n,
                    acc["nreq"] / n, acc["tot"] / n, acc["minq"] / n, acc["maxq"] / n,
                )
                for k in ("gap", "step", "update_states", "forward", "sample",
                          "prop", "minq", "maxq", "tot", "nreq"):
                    acc[k] = 0.0
                acc["steps"] = 0
            return r

        setattr(GPUModelRunner, name, inner)

    wrap("_update_states", "update_states")
    wrap("_model_forward", "forward")
    wrap("_sample", "sample")
    wrap_step("execute_model")

    # The plugin ships its own fork (ModelRunnerFL); wrap it too so the
    # timers cover the runner that actually executes the step.
    try:
        from vllm_fl.worker.model_runner import ModelRunnerFL as _FL

        _orig = {n: getattr(_FL, n) for n in
                 ("_update_states", "_model_forward", "_sample")}

        def _mk(name, key):
            _o = getattr(_FL, name)

            def _inner(self, *a, **kw):
                t0 = time.perf_counter()
                r = _o(self, *a, **kw)
                acc[key] += (time.perf_counter() - t0) * 1000.0
                return r

            setattr(_FL, name, _inner)

        for _n, _k in (("_update_states", "update_states"),
                       ("_model_forward", "forward"), ("_sample", "sample")):
            _mk(_n, _k)

        _fl_step = _FL.execute_model

        def _fl_step_inner(self, *a, **kw):
            t0 = time.perf_counter()
            if last["t"] is not None:
                acc["gap"] += (t0 - last["t"]) * 1000.0
            r = _fl_step(self, *a, **kw)
            acc["step"] += (time.perf_counter() - t0) * 1000.0
            last["t"] = time.perf_counter()
            so = a[0] if a else kw.get("scheduler_output")
            try:
                vals = list(so.num_scheduled_tokens.values())
                if vals:
                    acc["minq"] += min(vals)
                    acc["maxq"] += max(vals)
                    acc["tot"] += sum(vals)
                    acc["nreq"] += len(vals)
            except Exception:
                pass
            acc["steps"] += 1
            if acc["steps"] % 25 == 0:
                n = acc["steps"]
                nr = max(acc["nreq"], 1)
                logger.warning(
                    "fl timing (%d steps): step=%.0f ms/step (gap %.0f) | "
                    "update_states=%.1f forward=%.1f sample=%.1f propose=%.1f | "
                    "batch: reqs=%.1f tok/step=%.1f q_min=%.1f q_max=%.1f",
                    n, acc["step"] / n, acc["gap"] / n, acc["update_states"] / n,
                    acc["forward"] / n, acc["sample"] / n, acc["prop"] / n,
                    acc["nreq"] / n, acc["tot"] / n, acc["minq"] / n, acc["maxq"] / n,
                )
                for k in ("gap", "step", "update_states", "forward", "sample",
                          "prop", "minq", "maxq", "tot", "nreq"):
                    acc[k] = 0.0
                acc["steps"] = 0
            return r

        _FL.execute_model = _fl_step_inner
        logger.warning("fl timing: ModelRunnerFL phase timers installed")
    except Exception as exc:
        logger.warning("fl timing: ModelRunnerFL wrap failed: %s", exc)

    try:
        from vllm.v1.spec_decode.ngram_proposer_gpu import NgramProposerGPU
        orig_prop = NgramProposerGPU.propose

        def prop(self, *a, **kw):
            t0 = time.perf_counter()
            r = orig_prop(self, *a, **kw)
            acc["prop"] += (time.perf_counter() - t0) * 1000.0
            return r

        NgramProposerGPU.propose = prop
    except Exception:
        pass

    _INSTALLED = True
    logger.warning("fl timing: phase timers installed (VLLM_FL_TIMING=1)")
