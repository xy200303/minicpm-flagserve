+def _attn_dbg(self, attn_metadata, branch):
+    """TEMP-DBG: which attention branch runs per step (python values only)."""
+    try:
+        import os as _os
+        if _os.getenv("VLLM_FL_ATTN_DBG", "0") != "1":
+            return
+        sp = getattr(attn_metadata, "_fl_split", None)
+        n_pre = len(sp[2]) if sp else -1
+        n_dec = len(sp[3]) if (sp and sp[3] is not None) else 0
+        maxq = getattr(attn_metadata, "max_query_len", None)
+        key = (branch, maxq, n_pre, n_dec, bool(sp))
+        seen = globals().setdefault("_ATTN_DBG_SEEN", {})
+        seen[key] = seen.get(key, 0) + 1
+        if seen[key] <= 2 or seen[key] % 50 == 0:
+            print("[ATTN-DBG] branch=%s max_q=%s pre_rows=%s dec_rows=%s split=%s hit=%d"
+                  % (branch, maxq, n_pre, n_dec, bool(sp), seen[key]), flush=True)
+    except Exception:
+        pass
